<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份 / 设备迁移规则 -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="." />
        <include
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="cache" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="." />
        <include
            domain="database"
            path="." />
    </device-transfer>
</data-extraction-rules>
