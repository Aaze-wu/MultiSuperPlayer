<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络播放 / 云端翻译 / 云端 ASR -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 本地媒体库读取 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
        可选：内置文件浏览器里的「内部存储 / 存储卡」来源。

        它**不是**媒体库需要的权限——媒体库走 READ_MEDIA_* / SAF，一行都不依赖它。
        没有它时应用完全可用，只是文件浏览器少一个来源（`StorageAccess` 会如实
        报告状态）。所以这里既不放进默认申请路径，也不该有 `maxSdkVersion`：
        它是「所有文件访问」这个特殊权限，从 API 30 起才有，且只能由用户
        在系统设置页里手动开。

        `tools:ignore="ScopedStorage"`：lint 对这个权限有专门告警（Play 政策要求
        说明核心用途）。我们保留这个权限是有意的，理由写在 StorageAccess 的类注释里。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 后台播放 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        后台保活：请求加入「电池优化」白名单。

        它本身是普通权限、安装即授予，**没有它也能读白名单状态**（那是
        `PowerManager.isIgnoringBatteryOptimizations`）。缺了它只有一件事做不了：
        弹那个系统框时 `startActivity` 直接抛 `ActivityNotFoundException`
        （不是弹一个空框）——用户看到的是「点了没反应」，
        而代码会把这次失败读成「本机没有这个框」，静默退化成跳列表页。

        用途限于「长时间后台播放不被 Doze 掉网」，不是规避省电：
        本地文件播放实测能在 Doze 下正常续播，需要它的是网络串流。

        `tools:ignore="BatteryLife"`：lint 对这个权限有专门告警（Play 政策要求
        说明核心用途）。保留是有意的，理由同上与 `KeepAliveAccess` 的类注释。
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- 音效与蓝牙耳机 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:ignore="ProtectedPermissions" />

    <!--
        应用内更新：下载完 APK 后把自己交给系统安装器。

        这是普通权限、安装即授予，但它**不是**「装 APK 需要的那道门」：
        真正要开的是「安装未知应用」（每个应用一份的 special access，从 API 26 起），
        那个开关只能由用户在系统页里放给本应用。所以：这里声明它 → 权限页把它列进
        「安装时已授予」的折叠区 → 真正需要用户动手的那一步由更新页跳
        `ACTION_MANAGE_UNKNOWN_APP_SOURCES` 完成（见 `UpdateInstaller`）。

        缺了这条权限，`Intent.ACTION_VIEW` 加 APK 的 intent 会被系统直接拒绝，
        而用户看到的是「点安装没反应」。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 播放器不建议强制要求硬件特性，缺失时软件解码兜底 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- `networkSecurityConfig`：targetSdk ≥ 28 起系统默认禁明文 HTTP，而这个应用的
         网络播放、云端翻译、云端识别都要连用户自己填的 `http://<局域网 IP>` 地址
         （NAS、本地 LLM 服务……）。放开明文 + 不变更 HTTPS 证书策略的理由，
         全都写在那一份 XML 的注释里。 -->
    <application
        android:name=".MspApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultiSuperPlayer"
        tools:targetApi="34">

        <!-- `supportsPictureInPicture` = 这个 Activity 允许进画中画小窗。播放页的
             「画中画」按钮，以及 API 31+ 的「划回桌面自动进小窗」，都靠它；缺了会在
             运行时抛 IllegalStateException（不是忘记加权限——**画中画不需要任何权限**）。
             `resizeableActivity` 一起写出来：targetSdk 24+ 本来默认就是 true，写在这
             是为了让「这个 Activity 可以被系统改尺寸（小窗就是一种改尺寸）」在清单里
             看得见，而不是靠 SDK 版本的默认值推断。

             顺带一问：上面的 `configChanges` 已经包含 `orientation|screenSize|
             smallestScreenSize`，所以进/出小窗引起的配置变化不会重建 Activity——
             这正是我们要的（不重建就不会闪白、不会丢掉播放页的状态）。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.MultiSuperPlayer"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 系统的「打开方式」。

                 数据元素是**元素之间取并集、元素之内取交集**：单独一条
                 `<data android:scheme="file" />` = 「file 开头的任何类型」，
                 单独一条 `<data android:mimeType="video/*" />` = 「任何 scheme 的 video」。
                 也就是说下面这两条单独的元素其实已经把 http/https 上的视频包进来了：
                 浏览器能报出 `video/mp4` 时，本应用已经会出现在「打开方式」里。
                 后面那四条把 scheme 显式写出来，一是把这个事实写在纸面上，
                 二是不依赖「读者正确理解那个并集语义」。

                 ⚠️ 这里**刻意没有**只写 `<data android:scheme="http" />` 的元素：
                 那一条会让本应用出现在**每一次网页链接的「打开方式」里**
                 （新闻、购物、任何链接都是），既是骚扰，也会让用户把
                 「用本应用打开」当成浏览器坏了。需要放网络地址时走应用内的
                 「网络」入口（浏览页里那一行），不靠污染系统选择器。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <!-- 网页调起（如 OpenList / Alist 的「用外部应用打开」）：
                     scheme 与类型**必须成对写出**，理由见上面的警告。 -->
                <data
                    android:mimeType="audio/*"
                    android:scheme="http" />
                <data
                    android:mimeType="video/*"
                    android:scheme="http" />
                <data
                    android:mimeType="audio/*"
                    android:scheme="https" />
                <data
                    android:mimeType="video/*"
                    android:scheme="https" />
            </intent-filter>

            <!-- 从其他应用分享（单条 + 多条）。

                 `ACTION_SEND_MULTIPLE` 必须单独声明：系统不会把「分享 3 个视频」
                 当成 3 次 `ACTION_SEND`，它用的是另一个 action，少了这行就是
                 「选了几个视频里没有本应用」。收到多份时的行为是整队进队列、
                 从第一条开始放。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!--
            应用内更新：把下载到 cacheDir/updates/ 的 APK 交给系统安装器。

            共享目录的白名单在 `@xml/update_apk_paths` 里，那里写了为什么必须走
            FileProvider 以及为什么只放开一个子目录。这里只强调一点：
            `authorities` 带 `${applicationId}` 前缀，而不是写死包名——
            调试版与正式版包名不同，写死会让其中一个在运行时抛
            `IllegalArgumentException: Failed to find configured root`。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_apk_paths" />
        </provider>
    </application>
</manifest>
