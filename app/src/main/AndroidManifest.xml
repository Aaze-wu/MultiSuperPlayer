<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络播放 / 云端翻译 / 云端 ASR -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 本地媒体库读取 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
        可选：内置文件浏览器里的「内部存储 / 存储卡」来源。

        它**不是**媒体库需要的权限——媒体库走 READ_MEDIA_* / SAF，一行都不依赖它。
        没有它时应用完全可用，只是文件浏览器少一个来源（`StorageAccess` 会如实
        报告状态）。所以这里既不放进默认申请路径，也不该有 `maxSdkVersion`：
        它是「所有文件访问」这个特殊权限，从 API 30 起才有，且只能由用户
        在系统设置页里手动开。

        `tools:ignore="ScopedStorage"`：lint 对这个权限有专门告警（Play 政策要求
        说明核心用途）。我们保留这个权限是有意的，理由写在 StorageAccess 的类注释里。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 后台播放 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 音效与蓝牙耳机 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:ignore="ProtectedPermissions" />

    <!-- 播放器不建议强制要求硬件特性，缺失时软件解码兜底 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- `networkSecurityConfig`：targetSdk ≥ 28 起系统默认禁明文 HTTP，而这个应用的
         网络播放、云端翻译、云端识别都要连用户自己填的 `http://<局域网 IP>` 地址
         （NAS、本地 LLM 服务……）。放开明文 + 不变更 HTTPS 证书策略的理由，
         全都写在那一份 XML 的注释里。 -->
    <application
        android:name=".MspApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultiSuperPlayer"
        tools:targetApi="34">

        <!-- `supportsPictureInPicture` = 这个 Activity 允许进画中画小窗。播放页的
             「画中画」按钮，以及 API 31+ 的「划回桌面自动进小窗」，都靠它；缺了会在
             运行时抛 IllegalStateException（不是忘记加权限——**画中画不需要任何权限**）。
             `resizeableActivity` 一起写出来：targetSdk 24+ 本来默认就是 true，写在这
             是为了让「这个 Activity 可以被系统改尺寸（小窗就是一种改尺寸）」在清单里
             看得见，而不是靠 SDK 版本的默认值推断。

             顺带一问：上面的 `configChanges` 已经包含 `orientation|screenSize|
             smallestScreenSize`，所以进/出小窗引起的配置变化不会重建 Activity——
             这正是我们要的（不重建就不会闪白、不会丢掉播放页的状态）。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.MultiSuperPlayer"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 系统“打开方式” -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- 从其他应用分享 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
