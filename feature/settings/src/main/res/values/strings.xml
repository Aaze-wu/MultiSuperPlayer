<?xml version="1.0" encoding="utf-8"?>
<!--
  设置模块（入口页 + 外观 / 播放 / 字幕翻译 / 语音识别 / 关于）的文案。

  这个文件里**不该**出现别处已有的句子：主题名和强调色名在 `core:ui`，
  播放错误在 `core:player`，翻译失败在 `core:translate`。这里只放本模块自己说的
  「设置」语言——尤其是入口页那几行摘要，它们是用户判断「现在是什么状态」的唯一入口。
-->
<resources>

    <!-- ===== 通用 ===== -->

    <string name="msp_settings_title">设置</string>

    <!-- 四个子页的返回键都会念这一句 -->
    <string name="msp_settings_back">返回</string>

    <string name="msp_settings_cancel">取消</string>

    <!-- 设置读盘失败。不要写异常文本：用户能做的只有「重试」 -->
    <string name="msp_settings_read_failed">读取设置失败，请重试。</string>

    <!-- 入口页六行 -->
    <string name="msp_settings_appearance">外观</string>
    <string name="msp_settings_playback">播放</string>
    <string name="msp_settings_translation">字幕与翻译</string>
    <!-- 「语音识别」与「字幕与翻译」是两条不同的路：一条是本地把语音转成字幕，一条是把字幕换成另一种语言 -->
    <string name="msp_settings_asr">语音识别</string>
    <string name="msp_settings_file_access">文件访问</string>
    <!--
      入口页第 5 行。它原来就叫「文件访问」、点下去直接跳系统页；现在进去是一个页面，
      里面「所有文件访问」只是四行之一，所以标题换成上位概念。
      `msp_settings_file_access` 那一句留着给权限页里的「所有文件访问」用。
    -->
    <string name="msp_settings_permissions">权限</string>
    <string name="msp_settings_about">关于</string>

    <!-- ===== 入口页摘要 ===== -->

    <!--
      `%1$s`/`%2$s` 等是摘要里的各个片段，拼接本身走 `MspText.join`，
      分隔符就是下面这一条——换个语言想用「・」或者「, 」都可以。
    -->
    <!-- 引号不是内容：aapt2 会裁掉首尾空白，包上引号才能保住两侧的空格。 -->
    <string name="msp_settings_summary_sep">" · "</string>

    <!-- 三类尾巴：只有真的生效的那个才出现 -->
    <string name="msp_settings_summary_tail_artwork">封面取色</string>
    <string name="msp_settings_summary_tail_dynamic">系统取色</string>

    <!-- 开关开着但没生效（系统不支持 / 纯黑模式自动关掉）。不说出来的话用户只能怀疑开关坏了 -->
    <string name="msp_settings_summary_tail_dynamic_blocked">系统取色未生效</string>

    <!--
      自定义强调色只说「自定义」而不是预设名：说预设名会让用户以为自己的设置根本没存下来，
      而入口页那一行正是他判断「存没存上」的唯一依据。
    -->
    <string name="msp_settings_summary_accent_custom">自定义</string>

    <!-- 播放摘要的两条尾巴 -->
    <string name="msp_settings_summary_tail_force_software">强制软解</string>

    <!-- 「没有 FFmpeg」是安装包的事实，和开关无关，所以它单独说 -->
    <string name="msp_settings_summary_tail_no_ffmpeg">本包无 FFmpeg</string>
    <string name="msp_settings_summary_tail_no_position">不记位置</string>
    <string name="msp_settings_summary_tail_no_recent">不记播放历史</string>

    <!-- 「不阻止熄屏」也是偏离默认的那一种，但它的后果是“看着看着屏幕黑了”：说出来比不说好 -->
    <string name="msp_settings_summary_tail_no_keep_screen_on">不阻止熄屏</string>

    <!-- 「放行证书」是个安全状态，所以它和别的尾标不一样：开着的时候必须在设置入口就看得见 -->
    <string name="msp_settings_summary_tail_trust_certificates">放行证书</string>

    <!-- 例：`长按 2×`。`%1$s` 是档位（1.5× / 2× …） -->
    <string name="msp_settings_summary_long_press">长按 %1$s</string>

    <string name="msp_settings_summary_model_unset">未填模型名</string>

    <!-- 例：`译成中文`。`%1$s` 是目标语言名 -->
    <string name="msp_settings_summary_translate_to">译成%1$s</string>

    <!-- 还没配好。`%1$s` 是缺项清单（分隔符见 msp_settings_list_separator）。写清缺什么比「请检查设置」有用 -->
    <string name="msp_settings_summary_translation_incomplete">翻译未就绪（缺少：%1$s）</string>

    <!--
      ASR 的三种状态，同样**必须分开**：它们对应的下一步是「下载 / 继续下载 / 已经能用」。
      例：`离线中文（小模型） · 未下载 · 约 78 MB`、`离线中文（小模型） · 已下载 42%`。
    -->
    <string name="msp_settings_summary_asr_absent">未下载</string>
    <!-- `%1$d` 是整数百分比，向下取整（99.6% 不能说成 100%，那时还差最后一个字节） -->
    <string name="msp_settings_summary_asr_partial">已下载 %1$d%%</string>
    <string name="msp_settings_summary_asr_ready">已下载</string>

    <!-- 走了云端时入口行不再提本机模型（例：`云端识别 · 硅基流动`）。名字用短横排出，与上面的 ` · ` 一致 -->
    <string name="msp_settings_summary_asr_cloud">云端识别 · %1$s</string>
    <!-- 云端那条路的两个前置条件，缺哪个写哪个（与本机那条路的「未下载」并列同一个位置） -->
    <string name="msp_settings_summary_asr_missing_address">未填服务地址</string>
    <string name="msp_settings_summary_asr_missing_key">未填密钥</string>

    <!--
      本地翻译模型的三种状态。与 ASR 那把不同：这一条**不支持断点续传**，
      所以「未下完」不能被说成「继续下载」（那是在界面上承诺一件做不到的事）。
      例：`Qwen3 0.6B（本地） · 未下载 · 约 328.7 MB`。
    -->
    <string name="msp_settings_summary_local_model_absent">未下载</string>
    <!-- `%1$d` 是已收到的整数百分比，向下取整 -->
    <string name="msp_settings_summary_local_model_partial">未下完（已收到 %1$d%%）</string>
    <string name="msp_settings_summary_local_model_ready">已下载</string>

    <string name="msp_settings_summary_no_logs">还没有任何日志文件</string>

    <!-- 例：`12 个 · 1.4 MB`。第一参数是文件数，第二参数是总量 -->
    <string name="msp_settings_summary_log_usage">%1$d 个 · %2$s</string>

    <!-- 日志覆盖日期取不到时的占位（Windows 上曾出现过空字符串） -->
    <string name="msp_settings_summary_no_range">—</string>

    <!--
      文件访问的三种状态，**必须分开**：`unsupported` 那一行在界面上是灰的
      （系统根本没有那一页可去），`off` 那一行能点。合成一句「未开启」会让
      Android 10 的用户去一个没有这一项的设置页里翻找。
    -->
    <string name="msp_settings_file_access_on">已开启，可以浏览任意文件夹</string>
    <string name="msp_settings_file_access_off">未开启，点这里去系统设置开启</string>
    <string name="msp_settings_file_access_unsupported">本机系统版本不支持</string>

    <!--
      权限入口行的三种说法。**只看「媒体库读取」那一项**（理由见 `PermissionSummaries.entry`）：
      它是四项里唯一「不处理就会被误解」的一项——不允许时媒体库是空的，用户会以为扫描坏了；
      另外三项没允许是**默认状态**，把它们汇总进来说「3 项未开启」只会让每个用户
      都以为自己出了问题。
      `partial` 必须和 `ok` 分开：说成「已允许」的人会以为视频也能看了。
    -->
    <string name="msp_settings_summary_permissions_ok">已允许读取媒体库</string>
    <string name="msp_settings_summary_permissions_partial">只允许了一部分媒体库</string>
    <string name="msp_settings_summary_permissions_missing">未允许读取媒体库</string>

