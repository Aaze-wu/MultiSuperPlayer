    <string name="msp_settings_summary_model_unset">未填模型名</string>

    <!-- 例：`译成中文`。`%1$s` 是目标语言名 -->
    <string name="msp_settings_summary_translate_to">译成%1$s</string>

    <!-- 还没配好。`%1$s` 是缺项清单（逗号分隔）。写清缺什么比「请检查设置」有用 -->
