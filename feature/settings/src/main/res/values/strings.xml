    <string name="msp_settings_asr_source_invalid">要以 http:// 或 https:// 开头。</string>

    <string name="msp_settings_asr_dismiss">知道了</string>

    <!-- ===== 语音识别（云端）+ 密钥 ===== -->

    <string name="msp_settings_section_asr_cloud">云端服务</string>
    <string name="msp_settings_asr_cloud_service">服务商</string>
    <string name="msp_settings_asr_cloud_address">服务地址</string>
    <string name="msp_settings_asr_cloud_address_placeholder">https://api.example.com/v1</string>
    <!-- 真正发出去的那个完整端点。少了它，用户对「我填的 `/v1` 到底对不对」没有任何反馈 -->
    <string name="msp_settings_asr_cloud_endpoint">将请求：%1$s</string>
    <!-- 与下载源那一栏**相反**：这里空 = 没得可连，不是「用默认值」 -->
    <string name="msp_settings_asr_cloud_address_invalid">要填一个以 http:// 或 https:// 开头的地址。</string>
    <string name="msp_settings_asr_cloud_model">模型名</string>
    <!-- 例：`留空则用预设：whisper-1` -->
    <string name="msp_settings_asr_cloud_model_support">留空则用预设：%1$s</string>
    <!-- 必须写在设置页：默认服务商就不出时间轴。这是**结构性**的短徽标（由 supportsSegments 驱动），
         具体理由在服务商那一行的副标题（各家预设的 note）里讲。生成完才发现「只有一条字幕」是白跑一趟 -->
    <string name="msp_settings_asr_cloud_no_timeline">%1$s（不出时间轴）</string>
    <string name="msp_settings_section_asr_cloud_key">密钥</string>
    <!-- 这句话必须与翻译页那一句不同：写着「就不能翻译了」的提示放在这里会让人以为不影响识别 -->
    <string name="msp_settings_asr_delete_key_confirm">删除后就不能用这家服务识别了，需要重新粘贴一次密钥。</string>

    <!--
      清除生成的字幕。

      标题里写清是「生成的字幕」而不是「识别缓存」：这一页上离它最近的那个删除按钮
      删的是**模型**（190 MB，要重下），两个动作的代价完全不同，标题就得分开。
      规模与确认句在 `GeneratedSubtitleCacheStats` 里（需要把数字填进去），
      这里只放这一行、对话框标题和按钮。
    -->
    <string name="msp_settings_section_asr_cache">生成的字幕</string>
    <string name="msp_settings_asr_cache_clear">清除生成的字幕</string>
    <string name="msp_settings_asr_cache_clearing">正在清空…</string>
    <string name="msp_settings_asr_cache_clear_action">清空</string>
    <string name="msp_settings_asr_cache_clear_title">清除生成的字幕？</string>
    <string name="msp_settings_asr_cache_help">识别出来的字幕存在应用私有目录里，不会写到片子旁边，也不会上传。清除只删这些字幕；识别模型文件不会被删掉。</string>

    <!-- ===== 本地翻译模型（跑在设备上） ===== -->

    <!-- 页面标题，同时也是「字幕与翻译」页上那个入口行的标题 -->
    <string name="msp_settings_local_model">本地模型</string>
    <string name="msp_settings_section_local_model">翻译模型</string>
    <!-- 「不联网」是这条功能的卖点，也是用户第一个会怀疑的事（我的字幕被传到哪去了），所以放在最前面 -->
    <string name="msp_settings_local_model_hint">翻译全程在这台设备上完成：不联网、不需要账号，字幕内容不会离开手机。模型文件需要先下载一次。</string>

    <!-- 体积写在按钮上，而不是藏进一句说明：这是点下去之前唯一要知道的数字（约 329 MB） -->
    <string name="msp_settings_local_model_download">下载模型（约 %1$s）</string>
    <!-- 下了一半时的说法。下载器整文件重下（不支持断点续传），所以这里不能说「继续下载」 -->
    <string name="msp_settings_local_model_redownload">重新下载（约 %1$s）</string>
    <string name="msp_settings_local_model_partial_hint">上次没下完，已收到 %1$s。不支持断点续传，会从头开始。</string>
    <string name="msp_settings_local_model_stop">停止</string>
    <string name="msp_settings_local_model_downloading">正在下载模型…</string>
    <!-- 例：`已下载 12.3 MB / 328.7 MB` -->
    <string name="msp_settings_local_model_download_bytes">已下载 %1$s / %2$s</string>
    <!-- 校验要读完整份文件（345 MB 约 1 秒）。单独说一句，而且进度条不停在 100%：停在 100% 会造成「卡死了」的错觉 -->
    <string name="msp_settings_local_model_verifying">正在校验文件完整性…</string>
    <!-- 例：`Qwen3 0.6B（本地） 已就绪。` -->
    <string name="msp_settings_local_model_installed">%1$s 已就绪。</string>
    <!-- 已就绪时替掉「下载」按钮的那句话：它把下一步写出来（去哪儿选它），而不是只说「已下载」 -->
    <string name="msp_settings_local_model_ready_hint">已经就绪。把「字幕与翻译」里的服务商选成「本地（设备上运行）」就能用它。</string>

    <!-- 例：`删除模型（释放 328.7 MB）`。体积是**实际占用**：下了一半时不能说总体积 -->
    <string name="msp_settings_local_model_remove">删除模型（释放 %1$s）</string>
    <string name="msp_settings_local_model_remove_confirm_title">删除这个模型？</string>
    <!-- `%1$s` 是模型名，`%2$s` 是体积。「已经译好的字幕不受影响」必须说出来：那是删之前最让人犹豫的一点 -->
    <string name="msp_settings_local_model_remove_confirm_body">%1$s 要重新下载（%2$s）才能再用本地翻译。已经译好的字幕不受影响。</string>
    <string name="msp_settings_local_model_removed">已删除 %1$s。</string>
    <!-- 真的没文件可删时的话：不说成「已删除」，那句是假话 -->
    <string name="msp_settings_local_model_remove_missing">这条模型的文件已经不在手机上了。</string>

    <string name="msp_settings_section_local_model_source">下载源</string>
    <string name="msp_settings_local_model_source">模型下载地址</string>
    <string name="msp_settings_local_model_source_support">默认使用国内镜像源</string>
    <string name="msp_settings_local_model_source_invalid">要以 http:// 或 https:// 开头。</string>
    <string name="msp_settings_local_model_source_help">默认使用 hf-mirror.com 国内镜像。模型只有一份文件，改这一栏只影响之后的下载。</string>

    <string name="msp_settings_local_model_dismiss">知道了</string>

    <!-- ===== 设置项帮助（问号） ===== -->

    <!-- 帮助图标的无障碍名称。`%1$s` 是那一行的标题 -->
    <string name="msp_settings_help_icon_desc">%1$s：查看说明</string>

    <string name="msp_settings_force_software_help">默认由内核自动选择解码方式：系统解码器放不了或放错时，会自动改用内置的 FFmpeg。只有出现花屏、变色、音画不同步（硬件解码器出错）时才需要强制软解；代价是耗电和发热明显增加。</string>
    <string name="msp_settings_default_aspect_help">只影响之后打开的文件。在播放页里临时改的比例只作用于那一次播放，不会写到这里。</string>
    <string name="msp_settings_default_speed_help">跨文件保留：在播放页里改了倍速，这里也会跟着变。「长按倍速」是另一个开关，不受这里影响。</string>
    <string name="msp_settings_remember_position_help">关掉后每次从头播放。已经记住的位置不会被删除，重新打开这个开关就能继续用。</string>
    <string name="msp_settings_record_recent_help">关掉后不再记录新的播放历史。续播位置由「记住播放位置」单独控制，不受这里影响。已经记下的不会被删除，重新打开就能看到。</string>
    <string name="msp_settings_keep_screen_on_help">只在真的在播放时生效：暂停之后屏幕就可以按系统超时熄灭了（正是此时用户最想放下手机）。播放页的控制条上另有一个只对本次播放生效的开关，它不会改动这里的默认值。</string>
    <string name="msp_settings_trust_certificates_help">自建服务器（NAS、openlist/AList、反向代理）常用自签名证书，系统信任库里没有它，播放时会直接报「证书不被信任」。打开后所有 https 地址都会跳过证书校验，包括主机名不匹配和已过期的证书。只有确信那台服务器是自己的才打开。</string>    <string name="msp_settings_base_url_help">以 /v1 结尾的地址会被自动补上 /chat/completions。改这里可以指向自己的中转服务，只要它的接口与 OpenAI 兼容。</string>
    <string name="msp_settings_test_help">测试会真的翻一句样板文本，同时验证地址、密钥、模型名，以及这家厂商是否接受本应用发送的请求格式。会消耗极少的 token。</string>
    <string name="msp_settings_asr_source_help">默认使用 hf-mirror.com 国内镜像。填 https://huggingface.co 则改用官方源，国内访问通常很慢。</string>

