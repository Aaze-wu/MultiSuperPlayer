    <string name="msp_settings_artwork_color">Artwork colour</string>
    <string name="msp_settings_artwork_color_desc">Build the theme from the currently playing artwork</string>

    <string name="msp_settings_dynamic_color">Follow system colours</string>
    <string name="msp_settings_dynamic_color_desc">Theme colours from the system wallpaper (turns off when you pick an accent)</string>
    <string name="msp_settings_dynamic_color_covered">Overridden by artwork colour</string>
    <string name="msp_settings_dynamic_color_needs_api31">Needs Android 12 or newer</string>
    <string name="msp_settings_dynamic_color_blocked">Unavailable in pure black (system colours would be a pile of dark greys)</string>

    <string name="msp_settings_theme_note_artwork">The current colours come from artwork colour. It overrides the accent, but picking an accent switches back (that turns artwork colour off); when the artwork has no usable colour (a black-and-white cover, say) it falls back to the accent, so the accent still matters.</string>
    <string name="msp_settings_theme_note_dynamic">The current colours come from system colours. Picking an accent turns system colours off and the colours follow the accent right away.</string>
    <string name="msp_settings_theme_note_accent">The accent colour applies to the whole app immediately: titles, buttons, progress bars and lyric highlighting all follow it.</string>

    <string name="msp_settings_accent_label">Accent colour</string>

    <string name="msp_settings_language_note_system">The selected language is recorded by the system. Changing it in Settings → Apps → MultiSuperPlayer → Language is the same setting; the two always agree.</string>
    <string name="msp_settings_language_note_app_only">The selected language only affects this app. The system date and number formats do not change; the language used for dates comes from the system settings.</string>
    <string name="msp_settings_language_follow_system">Follow system</string>

    <string name="msp_settings_section_decoding">Decoding</string>
    <string name="msp_settings_force_software">Force software decoding</string>
    <string name="msp_settings_force_software_no_ffmpeg">This build has no FFmpeg (CPU architecture unsupported), so turning this on has no effect</string>
    <string name="msp_settings_force_software_on">Decoding with FFmpeg. Use it to narrow down picture problems; the cost is noticeably higher battery drain and heat.</string>
    <string name="msp_settings_force_software_off">Off by default: when the system decoder cannot play a file or decodes it wrongly, the core switches to the built-in FFmpeg on its own. Turn this on only for a garbled picture, wrong colours or out-of-sync audio and video (a faulty hardware decoder).</string>

    <string name="msp_settings_section_picture_speed">Picture and speed</string>

    <string name="msp_settings_default_aspect">Default aspect ratio</string>
    <string name="msp_settings_default_aspect_desc">Only affects files opened later. A ratio picked for one file in the player is not saved here.</string>

    <string name="msp_settings_default_speed">Default speed</string>
    <string name="msp_settings_default_speed_desc">Kept across files: changing the speed in the player changes this too.</string>

    <string name="msp_settings_boost_speed">Long-press speed</string>
    <string name="msp_settings_boost_speed_desc">Hold the picture to use this speed; releasing returns to the previous one.</string>

    <string name="msp_settings_remember_position">Remember playback position</string>
    <string name="msp_settings_remember_position_on">Resume from where you left off next time the same file is opened</string>
    <string name="msp_settings_remember_position_off">Always start from the beginning. Positions already remembered are not deleted; turning this back on makes them available again.</string>

    <!--
      Sits right above/below the row above, so both subtitles must make the difference
      obvious: the two switches look alike, and getting this one wrong just means "nothing
      new shows up in the list" later on, which nobody would connect to a switch.
    -->
    <string name="msp_settings_record_recent">Record recent plays</string>
<string name="msp_settings_record_recent_on">What you play shows up on the Recent page, and opening it continues from where you stopped</string>
<string name="msp_settings_record_recent_off">Stops recording new play history (resume positions are separate). What is already recorded is not deleted; turning this back on brings it back.</string>

