    <string name="msp_settings_local_model">On-device model</string>
    <string name="msp_settings_section_local_model">Translation model</string>
    <!-- No network is the selling point, and the first thing users doubt, so it comes first. -->
    <string name="msp_settings_local_model_hint">Translation runs entirely on this device: no network, no account, and subtitle text never leaves the phone. The model file has to be downloaded once.</string>

    <!-- The size goes on the button: it is the one number worth knowing before tapping (about 329 MB). -->
    <string name="msp_settings_local_model_download">Download model (%1$s)</string>
