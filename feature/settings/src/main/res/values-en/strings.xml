    <string name="msp_settings_section_asr_route">How to recognize</string>
    <!--
      Shown right under the two choices when Cloud is picked. The privacy notice belongs on the page
      where the choice is made, not only on the player's button: this is where the user has time to read it.
    -->
    <string name="msp_settings_asr_route_cloud_note">Cloud recognition uploads the audio to the address you enter, five minutes per chunk, before anything is recognized. Uploading is outward-facing and cannot be undone; results are written on this device only.</string>

    <string name="msp_settings_section_asr_model">Recognition model</string>
    <!-- Nothing is uploaded — that is both the selling point and the first thing users doubt, so it comes first;
         it describes the on-device route, so it sits with that choice rather than with the model list. -->
    <string name="msp_settings_asr_model_hint">Recognition runs entirely on this device; audio is never uploaded. Expect roughly the length of the audio.</string>

