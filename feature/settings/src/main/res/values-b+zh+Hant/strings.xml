    <string name="msp_settings_dynamic_color">跟隨系統取色</string>
    <string name="msp_settings_dynamic_color_desc">使用系統桌布產生的主題色（選強調色時會自動關掉）</string>
    <string name="msp_settings_dynamic_color_covered">已被封面取色覆蓋</string>
