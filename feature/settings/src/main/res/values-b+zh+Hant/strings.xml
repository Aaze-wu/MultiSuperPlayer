    <string name="msp_settings_summary_asr_missing_key">未填金鑰</string>

    <!--
      本機翻譯模型的三種狀態。與 ASR 那把不同：這條**不支援斷點續傳**，
      所以「未下完」不能說成「繼續下載」（那是在介面上承諾一件做不到的事）。
    -->
    <string name="msp_settings_summary_local_model_absent">未下載</string>
