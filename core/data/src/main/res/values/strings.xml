<?xml version="1.0" encoding="utf-8"?>
<!--
    数据层的界面文案。

    这个模块**自己不说人话**：所有要显示的文字都按 MspText 交出去，由界面在
    正确的语言下解析（见 core:common 的 MspText）。数据层只挑「该说哪一句」。
-->
<resources>

    <!-- ============================================================
         字幕：读不了的原因
         ============================================================
         系统异常自带的 message 原样透出（通常已经是英文/系统语言），只有
         「我们自己发现的失败」才用这里的句子——否则真实的系统原因会被一句
         中文盖掉（见 SubtitleRepository.detailOr）。
         ============================================================ -->
    <string name="msp_subtitle_reason_directory_unreadable">无法读取字幕目录</string>
    <string name="msp_subtitle_reason_file_unreadable">无法读取文件</string>
    <string name="msp_subtitle_reason_file_unopenable">打不开这个文件，可能已被移动或删除</string>
    <string name="msp_subtitle_reason_unparsable">无法解析这个字幕文件</string>
    <!-- %1$d：文件大小（MB） -->
    <string name="msp_subtitle_reason_file_too_large">文件太大（%1$d MB），可能不是字幕文件</string>

    <!-- ============================================================
         媒体库
         ============================================================ -->
    <!-- %1$s：系统异常的类名 -->
    <string name="msp_library_scan_failed">扫描媒体库失败（%1$s）</string>

    <!-- ============================================================
         画面比例（AspectRatioMode 的 label / description）
         ============================================================ -->
    <string name="msp_aspect_fit_label">适应</string>
    <string name="msp_aspect_fit_desc">完整显示画面，多出来的地方留黑边</string>
    <string name="msp_aspect_crop_label">裁剪</string>
    <string name="msp_aspect_crop_desc">铺满屏幕，裁掉超出的部分</string>
    <string name="msp_aspect_stretch_label">拉伸</string>
    <string name="msp_aspect_stretch_desc">拉伸铺满，比例会变形</string>
    <string name="msp_aspect_original_label">原始</string>
    <string name="msp_aspect_original_desc">按片源像素显示，不放大也不缩小</string>

    <!-- ============================================================
         内置文件浏览器
         ============================================================ -->
    <string name="msp_browser_storage_internal">内部存储</string>
    <string name="msp_browser_storage_removable">存储卡</string>
    <string name="msp_browser_sort_name_asc">名称（A-Z）</string>
    <string name="msp_browser_sort_name_desc">名称（Z-A）</string>
    <string name="msp_browser_sort_newest">最新在前</string>
    <string name="msp_browser_sort_oldest">最旧在前</string>

    <!-- 兜底文案：用户授权的是某个卷的根，但树里没带名字，我们也不知道是哪一张卡。 -->
    <string name="msp_browser_volume_root">存储根目录</string>

    <!--
      字幕样式的**档位名**。

      放在 core:data 而不是播放页里，是因为它们绑在 `SubtitleStyle` 的枚举上：
      那个枚举是持久化契约（存的是枚举名），档位文案和枚举必须在同一个模块里，
      否则会出现「加了一个档位但没有人给它写文案」——而 `entries` 的 `label`
      是必填参数，漏了就编译不过，这正是想要的。

      小节标题与行内标签不在这里：它们属于画它们的那个页面（播放页字幕面板 / 设置页）。
    -->
    <string name="msp_subtitle_style_normal">标准</string>
    <string name="msp_subtitle_style_size_small">小</string>
    <string name="msp_subtitle_style_size_large">大</string>
    <string name="msp_subtitle_style_size_huge">特大</string>
    <string name="msp_subtitle_style_line_tight">紧凑</string>
    <string name="msp_subtitle_style_line_loose">宽松</string>
    <string name="msp_subtitle_style_outline_none">无</string>
    <string name="msp_subtitle_style_outline_thin">细</string>
    <string name="msp_subtitle_style_outline_thick">粗</string>
    <string name="msp_subtitle_style_margin_edge">贴边</string>
    <string name="msp_subtitle_style_margin_raised">抬高</string>
    <string name="msp_subtitle_style_margin_high">很高</string>

</resources>
