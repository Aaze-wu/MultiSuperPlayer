<?xml version="1.0" encoding="utf-8"?>
<!--
    UI strings of the data layer.

    This module never writes user-facing prose in code: it hands out an MspText
    (see core:common) so the UI resolves it in the language the user chose.
-->
<resources>

    <!-- ==== Subtitles: why it could not be read ====
         Messages that come from a system exception are passed through as-is (they
         are already in the system language); only failures we detect ourselves
         use these sentences. ==== -->
    <string name="msp_subtitle_reason_directory_unreadable">Could not read the subtitle folder</string>
    <string name="msp_subtitle_reason_file_unreadable">Could not read the file</string>
    <string name="msp_subtitle_reason_file_unopenable">Cannot open this file; it may have been moved or deleted</string>
    <string name="msp_subtitle_reason_unparsable">Could not parse this subtitle file</string>
    <!-- %1$d: file size in MB -->
    <string name="msp_subtitle_reason_file_too_large">File is too large (%1$d MB) and may not be a subtitle file</string>

    <!-- ==== Subtitles: parse warnings ====
         What the parsers themselves noticed lives in core:subtitle; this one is
         something only the reader of the file can know - the encoding was guessed. ==== -->
    <!-- %1$s: charset actually used, already normalised (e.g. GB18030 / Shift-JIS) -->
    <string name="msp_subtitle_warn_charset_guessed">Not UTF-8; decoded as %1$s. If the text looks garbled, re-save the file as UTF-8.</string>

    <!-- ==== Media library ==== -->
    <!-- %1$s: name of the system exception class -->
