         畫面比例（AspectRatioMode 的 label / description）
         ============================================================ -->
    <string name="msp_aspect_fit_label">適應</string>
    <string name="msp_aspect_fit_desc">完整顯示畫面，多出來的地方留黑邊</string>
    <string name="msp_aspect_crop_label">裁剪</string>
