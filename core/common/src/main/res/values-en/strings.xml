    <string name="msp_api_only">API %1$d</string>

    <string name="msp_screen_size">%1$d×%2$d @%3$ddpi</string>

    <string name="msp_screen_size_plain">%1$d×%2$d</string>

    <!--
      English keeps the same neutral "N unit" shape as the source language on
      purpose: the plural of "1 hour" would otherwise need `<plurals>`, and this
      string is composed from up to three of them at once.
    -->
    <string name="msp_duration_hours">%1$d h</string>
    <string name="msp_duration_minutes">%1$d min</string>
    <string name="msp_duration_seconds">%1$d s</string>

    <string name="msp_duration_hours_minutes">%1$d h %2$d min</string>
    <string name="msp_duration_hours_seconds">%1$d h %2$d s</string>
    <string name="msp_duration_minutes_seconds">%1$d min %2$d s</string>
    <string name="msp_duration_full">%1$d h %2$d min %3$d s</string>

</resources>
