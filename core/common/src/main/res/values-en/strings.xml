<?xml version="1.0" encoding="utf-8"?>
<!--
  English translations for core:common.

  Keep the positional arguments (`%1$s`, `%2$d`) — reorder them if English reads
  better that way, but never change how many there are.
-->
<resources>

    <string name="msp_value_unknown">Unknown</string>

    <string name="msp_row_device">Device</string>
    <string name="msp_row_system">System</string>
    <string name="msp_row_abi">CPU ABI</string>
    <string name="msp_row_screen">Display</string>
    <string name="msp_row_language">Language</string>

    <string name="msp_row_version">Version</string>
    <string name="msp_row_source">Build source</string>
    <string name="msp_row_build_time">Build time</string>

    <string name="msp_version_with_code">%1$s (%2$d)</string>

    <!-- English uses a plain half-width parenthesis pair. -->
    <string name="msp_wrapped_in_parens">%1$s (%2$s)</string>

    <string name="msp_appended_with_comma">%1$s, %2$s</string>

    <!-- Glue template: `%2$s` is the separator the caller supplies. -->
    <string name="msp_joined">%1$s%2$s%3$s</string>

    <string name="msp_dirty_suffix">uncommitted changes</string>

    <string name="msp_device_brand_model">%1$s %2$s</string>

