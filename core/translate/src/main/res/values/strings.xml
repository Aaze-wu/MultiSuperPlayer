<resources>

    <!--
      ===== 翻译失败话术 =====

      这里是**唯一**一处可以写翻译失败文案的地方。两条必须分开的路径：
      形状不对（BadResponse ⇒ 换模型/缩小批次）和被截断（Truncated ⇒ 调大预算），
      补救方向相反，文案绝不能合并。

      `%1$s` / `%1$d` 都是参数：数字一律当参数传，不要拼进文案里——
      拼接会把「哪个数字对应哪个含义」写死在代码里，换语言时容易错位。
    -->
    <string name="msp_translate_fail_not_configured">翻译设置尚未填完：缺少 %1$s。</string>
    <string name="msp_translate_fail_not_configured_hint">请到「设置 → 字幕翻译」中补全后重试。</string>

    <string name="msp_translate_fail_unauthorized">鉴权失败（HTTP %1$d）。</string>
    <string name="msp_translate_fail_unauthorized_hint">密钥可能填错或已过期；部分服务商的密钥与地域绑定，跨地域使用会鉴权失败。</string>

    <string name="msp_translate_fail_quota">账户余额或额度不足（HTTP %1$d）。</string>
    <string name="msp_translate_fail_quota_hint">请先到服务商后台充值；反复重试只会更快耗尽额度。</string>

    <string name="msp_translate_fail_rate_limited">请求太频繁（HTTP %1$d）。</string>
    <string name="msp_translate_fail_rate_limited_wait">服务商要求等 %1$d 秒。稍后重试即可。</string>
    <string name="msp_translate_fail_rate_limited_hint">等一会儿再重试即可；一直这样说明当前服务商正在拥堵。</string>

    <string name="msp_translate_fail_rejected">服务商拒绝了这次请求（HTTP %1$d）。</string>
    <string name="msp_translate_fail_rejected_hint">多半是模型名不存在、或者该模型不支持这种请求格式。</string>

    <string name="msp_translate_fail_server">服务商内部错误（HTTP %1$d）。</string>
    <string name="msp_translate_fail_server_hint">与本地设置无关，可稍后重试；若持续出现，请查看服务商状态页。</string>

    <string name="msp_translate_fail_network">连不上服务商。</string>

    <string name="msp_translate_fail_bad_response">返回内容的结构不对（不是额度问题）。</string>
    <string name="msp_translate_fail_bad_response_hint">重试通常得到相同结果：请更换更稳定的模型，或改用其他服务商。</string>

    <string name="msp_translate_fail_empty">模型这次一个字都没输出%1$s。</string>
    <string name="msp_translate_fail_reason">（结束原因：%1$s）</string>
    <string name="msp_translate_fail_reasoning_tokens">（本次思考用了 %1$d tokens）</string>
    <string name="msp_translate_fail_empty_hint">此类情况多为推理模式耗尽了输出预算%1$s：改用不进行推理的模型即可正常翻译。</string>

    <string name="msp_translate_fail_truncated">本批次过长，输出已被截断。%1$s</string>
    <string name="msp_translate_fail_truncated_hint">本次上限 %1$d tokens，%2$s自动拆分后仍超出：请改用单次输出上限更高的模型。</string>
    <string name="msp_translate_fail_truncated_estimate">这一批估算需要约 %1$d tokens，</string>

    <!-- 服务商没有给出任何说明时找不到原文，界面就不显示原文块。 -->

    <!--
      ===== 配置缺项 =====

      这一组既给「设置页的清单」用，也给「引擎说还差什么」用——两处文案同源，
      否则会出现「设置页说可以翻译、点下去引擎说不满足条件」这种互相打脸的状态。
    -->
    <string name="msp_translate_missing_base_url">服务地址</string>
    <string name="msp_translate_missing_base_url_scheme">服务地址（需要以 http:// 或 https:// 开头）</string>
    <string name="msp_translate_missing_model">模型名</string>
    <string name="msp_translate_missing_api_key">API 密钥</string>
    <string name="msp_translate_missing_batch_size">批次大小（至少 1 行）</string>

