<?xml version="1.0" encoding="utf-8"?>
<!--
    字幕解析器自己说的两句话：**解析告警**（不致命，跳几行照样播）与
    **解析失败的原因**（致命，整份字幕读不出来）。

    ## 为什么住在这里，而不是 core:model 或 core:data

    这些句子是「解析器对这个文件的判断」——「时间码读不出来」「没有 WEBVTT 头」
    「根元素不是 tt」。谁解析、谁负责说清楚，所以文案跟着解析器走：
    core:model 只放大家共享的模型与两条通用文案（`msp_value_unknown` /
    `msp_joined`），往那里堆格式细节会让它变成文案仓库；core:data 也不该替
    解析器解释格式问题（它只负责「读不到文件」这类系统层的事）。

    ## 键名为什么带 `msp_subtitle_` 前缀

    Android 的资源是**按名字跨模块全局合并**的：两个模块各写一条同名 string
    不会报错，只会有一个静默胜出——症状是「同一句话在不同设备上不一样」，
    排查时几乎没人会想到去比对资源名。前缀让它不可能撞车。

    ## 三种语言必须同时有这条键

    少一条不会崩、不会报错，只在切到那个语言时静默回落到中文。
    `SubtitleStringsTest` 把这件事变成一条会红的断言。
-->
<resources>

    <!-- ============================================================
         ASS / SSA
         ============================================================ -->
    <!-- 样式行没有 Name=，没有名字就没法被 Dialogue 的 Style 字段引用。 -->
    <string name="msp_subtitle_warn_ass_style_no_name">样式行缺少 Name 字段，已跳过</string>
    <!-- %1$d / %2$d：脚本没声明画布尺寸时使用的宽与高（像素）。 -->
    <string name="msp_subtitle_warn_ass_no_play_res">缺少 PlayResX/PlayResY，按 %1$dx%2$d 估算位置</string>
    <!-- %1$s：文件里那行 Start 的原文（读不出来才有这句）。 -->
    <string name="msp_subtitle_warn_ass_event_no_start">事件缺少可解析的 Start：%1$s</string>

    <!-- ============================================================
         LRC / 增强型 LRC
         ============================================================ -->
    <string name="msp_subtitle_warn_lrc_unknown_line">无法识别的行：%1$s</string>
    <string name="msp_subtitle_warn_lrc_tag_not_first">时间标签前有内容，已忽略该行：%1$s</string>
    <!-- %1$d：时间码（毫秒）；%2$d：挤在同一个时间码上的行数。 -->
    <string name="msp_subtitle_warn_lrc_merge_overflow">时间码 %1$dms 上有 %2$d 行文本，未做双语合并</string>

    <!-- ============================================================
         SRT / WebVTT
         ============================================================ -->
    <string name="msp_subtitle_warn_srt_unknown_block">跳过无法识别的时间码块：%1$s</string>
    <!--
      这条 SRT 与 VTT **共用**：两个解析器对同一种毛病说的是同一句话，
      各写一份只会让译者把同一句翻两遍，而且很容易只改其中一份。
    -->
    <string name="msp_subtitle_warn_bad_range">时间码无法解析：%1$s</string>
    <!-- %1$d：第几条（按文件里出现的顺序，不是序号行里写的数字）。 -->
    <string name="msp_subtitle_warn_srt_end_before_start">第 %1$d 条结束时间早于开始时间，已按开始时间 + 1 秒修正</string>
    <string name="msp_subtitle_warn_vtt_no_header">缺少 WEBVTT 头，按无头 VTT 解析</string>

    <!-- ============================================================
         TTML / DFXP
         ============================================================ -->
    <string name="msp_subtitle_warn_ttml_root_not_tt">根元素是 &lt;%1$s&gt;，不是 &lt;tt&gt;，仍按 TTML 尽力解析</string>
    <string name="msp_subtitle_warn_ttml_p_no_begin">跳过缺少 begin 的 &lt;p&gt; 元素</string>
    <string name="msp_subtitle_warn_ttml_p_no_end">&lt;p begin=%1$d&gt; 没有有效结束时间，已按 2 秒兜底</string>
    <string name="msp_subtitle_warn_ttml_xml_failed">XML 解析失败：%1$s</string>

    <!-- ============================================================
         统一入口：格式判定与失败原因
         ============================================================ -->
    <!-- %1$s：判定出来的格式；%2$s：实际解得出来的格式（这一句里用了它两次）。 -->
    <string name="msp_subtitle_warn_format_mismatch">格式判定为 %1$s 但内容更像 %2$s，已按 %2$s 解析</string>
    <string name="msp_subtitle_error_empty">字幕内容为空</string>
    <!-- %1$s：判定格式；%2$s：已经试过的格式列表。 -->
    <string name="msp_subtitle_error_unparsable">无法解析字幕（判定格式：%1$s；已尝试：%2$s）</string>
    <string name="msp_subtitle_error_lrc_no_timestamps">LRC 中没有找到任何可解析的时间标签</string>
    <string name="msp_subtitle_error_ttml_no_root">TTML 文件没有根元素</string>
    <string name="msp_subtitle_error_ttml_not_xml">TTML 不是合法 XML：%1$s</string>

</resources>
