<?xml version="1.0" encoding="utf-8"?>
<!--
  core:model 只有两条文案：[MspText] 自己的兜底词与拼接包装。

  它们本来住在 core:common，跟着 MspText 一起搬过来——因为 core:subtitle 的解析器
  也要产出 MspText（那些「这一行有问题」的告警必须能翻译），而解析器能依赖的
  最底层模块就是这个。少一条，字幕告警就只能继续写死中文。

  命名规则与其它模块一致：`msp_<域>_<内容>`；带参数的字符串一律用位置参数（`%1$s`），
  不用 `%s`：翻译时语序会变，位置参数才允许译者调换顺序。
-->
<resources>

    <!-- 「取不到这个值」。设备/构建信息里每个字段的兜底，绝不能显示成空白 -->
    <string name="msp_value_unknown">未知</string>

    <!--
      通用拼接：把若干段接成一句。分隔符（`%2$s`）由调用方传进来，所以「用 · 还是用、」
      由文案决定，而「两两拼接」这件事不必每个模块各写一遍，也不用拼 `String`。
    -->
    <string name="msp_joined">%1$s%2$s%3$s</string>

</resources>
