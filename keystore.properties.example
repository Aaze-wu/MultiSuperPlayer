# ===========================================================================
# Release 签名说明（模板，勿提交真实值）
# ===========================================================================
# 1. 生成 keystore（一次性）：
#      keytool -genkeypair -v -keystore msp-release.jks -keyalg RSA -keysize 4096 \
#              -validity 10000 -alias msp
# 2. 复制本文件为 keystore.properties，填入真实路径与口令，放到仓库根目录。
# 3. storeFile 支持相对仓库根目录的路径。
#
# storeFile=msp-release.jks
# storePassword=********
# keyAlias=msp
# keyPassword=********
